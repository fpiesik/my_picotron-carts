:: core/app.lua
--[[pod_format="raw",created="2026-04-15 07:46:23",modified="2026-04-15 08:19:31",revision=6]]
include "core/scene_manager.lua"
include "core/save.lua"
include "core/input.lua"

local function make_app()
  local app = {}

  function app:init()
    self.shared = {
      coins = 0
    }

    self.save = create_save_system("/appdata/megagame/save.pod")
    self.input = create_input()
    self.scene_manager = create_scene_manager(self)

    self.save:load()

    if self.save.data.coins then
      self.shared.coins = self.save.data.coins
    end

    self.scene_manager:switch("hub")
  end

  function app:update()
    self.input:update()
    self.scene_manager:update()
  end

  function app:draw()
    self.scene_manager:draw()
  end

  return app
end

function create_app()
  return make_app()
end

function finish_minigame(app, game_name, score, reward)
  app.save:set_highscore(game_name, score)
  app.save:add_coins(reward)
  app.scene_manager:switch("hub")
end
:: core/input.lua
--[[pod_format="raw",created="2026-04-15 07:47:50",modified="2026-04-19 15:56:00",revision=7]]
function create_input()
  local input = {
    left = false,
    right = false,
    up = false,
    down = false,
    action = false,
    back = false
  }

  function input:update()
    self.left = btnp(0)
    self.right = btnp(1)
    self.up = btnp(2)
    self.down = btnp(3)
    self.action = btnp(4)
    self.back = btnp(5)
  end

  return input
end
:: core/save.lua
--[[pod_format="raw",created="2026-04-15 07:50:20",modified="2026-04-15 08:19:29",revision=4]]
function create_save_system(path)
  local save = {
    path = path,
    data = {
      unlocked = {
        dodger = true,
        collector = true
      },
      highscores = {
        dodger = 0,
        collector = 0
      },
      coins = 0
    }
  }

  function save:load()
    local loaded = fetch(self.path)
    if loaded then
      self.data = loaded
    end
  end

  function save:store()
    store(self.path, self.data)
  end

  function save:set_highscore(game_name, score)
    local old = self.data.highscores[game_name] or 0
    if score > old then
      self.data.highscores[game_name] = score
      self:store()
    end
  end

  function save:add_coins(amount)
    self.data.coins = (self.data.coins or 0) + amount
    self:store()
  end

  return save
end
:: core/scene_manager.lua
--[[pod_format="raw",created="2026-04-15 07:50:15",modified="2026-04-19 16:19:33",revision=13]]
include "scenes/hub.lua"
include "games/dodger.lua"
include "games/collector.lua"
include "games/notenkoffer.lua"

local registry = {
  hub = create_hub_scene,
  dodger = create_dodger_game,
  collector = create_collector_game,
  notenkoffer = create_koffer_game
}

function create_scene_manager(app)
  local sm = {
    app = app,
    current = nil,
    current_name = nil
  }

  function sm:switch(name, params)
    if self.current and self.current.leave then
      self.current:leave(self.app)
    end

    local factory = registry[name]

    if not factory then
      self.current = nil
      self.current_name = nil
      printh("scene not found: "..tostr(name))
      return
    end

    self.current = factory()
    self.current_name = name

    if self.current and self.current.init then
      self.current:init(self.app, params)
    end
  end

  function sm:update()
    if self.current and self.current.update then
      self.current:update(self.app)
    end
  end

  function sm:draw()
    if self.current and self.current.draw then
      self.current:draw(self.app)
    else
      cls(1)
      print("no active scene", 40, 60, 7)
    end
  end

  return sm
end
:: core/sfxdata.lua
--[[pod_format="raw",created="2025-02-16 10:19:26",modified="2025-05-12 15:41:17",revision=1359]]
-- sfx/music data wrangler
-- by pancelor

-- The docs call this the "index", I call it the "header"
-- https://www.lexaloffle.com/dl/docs/picotron_synth.html#Index
function sfxheader_read()
  local num_instruments, num_tracks, num_patterns, flags = peek2(0x30000, 4)
  -- ...8 unused bytes here...
  local insts_addr, tracks_addr, patterns_addr, unused1 = peek4(0x30010, 4)
  assert(unused1==0,"bad sfx header 1")
  local tick_len, def_len, def_spd = peek2(0x30020, 3)
  local def_spd2, unused2, unused3, unused4 = peek(0x30026, 4)
  -- TODO def_spd2 v. def_spd?
  assert(unused2==0,"bad sfx header 2")
  assert(unused3==0,"bad sfx header 3")
  assert(unused4==0,"bad sfx header 4")
  return {
    num_instruments = num_instruments,
    num_tracks = num_tracks,
    num_patterns = num_patterns,
    flags = flags, --0x1 use default track indexing (base+0x20000, increments of 328 bytes)
    insts_addr = insts_addr, --relative address of instruments
    tracks_addr = tracks_addr, --relative address of track index
    patterns_addr = patterns_addr, --relative address of pattern data
    tick_len = tick_len, --in 1/16ths of a sample at 44100Hz [0 means 5880 -- 120 ticks / second]
    def_len = def_len, --used by patterns that do not have a default length specified
    def_spd = def_spd, --used by patterns that do not have a default speed specified
    def_spd2 = def_spd2, -- ??
  }
end

function pattern_read(i)
  local base = 0x30100 + sfxheader_read().patterns_addr -- normally 0x30100
  local addr = base + i*20
  local tracks = { peek(addr, 8) }
  local flow_flags, channel_mask = peek(addr+8, 2)
  local len = peek2(addr+10)
  -- ...8 unused bytes here...
  return {
    tracks = tracks, -- array with 8 track ids
    flow_flags = flow_flags, -- 0x1 loop forward, 0x2 loop backward, 0x4 stop
    channel_mask = channel_mask, -- 0x1 is tracks[1] unmuted? 0x2 is tracks[2] unmuted? 0x4 => tracks[3], 0x8 => tracks[4], ... 0x80 => tracks[8]
    len = len, --TODO: how does this interact with track length and header def_len/def_len2?
  }
end

function track_read(i)
  local header = sfxheader_read()
  assert(header.flags&1==1,"unknown track format")
  local base = 0x30000 + header.tracks_addr -- normally 0x50000
  local addr = base + i*328
  local len = peek2(addr)
  local spd, loop0, loop1, delay, flags, unused = peek(addr+2, 6)
  assert(unused==0,"bad sfx track")
  -- note: if len<64 then some of this data is irrelevant:
  local pitches = { peek(addr+8,64) }
  local instruments = { peek(addr+72,64) }
  local volumes = { peek(addr+136,64) }
  local effects = { peek(addr+200,64) }
  local effect_params = { peek(addr+264,64) }
  return {
    len = len,
    spd = spd,
    loop0 = loop0,
    loop1 = loop1,
    delay = delay,
    flags = flags, --0x1 mute
    -- 64-length arrays, 1 entry per note:
    pitches = pitches,
    instruments = instruments,
    volumes = volumes, -- a 0xFF entry means muted
    effects = effects, -- stored as their ascii code -- retrieve with ord()
    effect_params = effect_params,
  }
end
function track_write(i,spd)
  local header = sfxheader_read()
  assert(header.flags&1==1,"unknown track format")
  local base = 0x30000 + header.tracks_addr -- normally 0x50000
  local addr = base + i*328
  poke (addr+2,spd) -- set spd
end
-- an alternate version of track_read that extracts a single row
-- ti: track index
-- ri: row index
function track_row_read(ti,ri)
  local header = sfxheader_read()
  assert(header.flags&1==1,"unknown track format")
  local base = 0x30000 + header.tracks_addr -- normally 0x50000
  local addr = base + ti*328 + ri
  return {
    pitch = peek(addr+8),
    instrument = peek(addr+72),
    volume = peek(addr+136),
    effect = peek(addr+200),
    effect_params = peek(addr+264),
  }
end
function track_row_write(ti,ri,pitch,inst,vol,eff,effp)
  local header = sfxheader_read()
  assert(header.flags&1==1,"unknown track format")
  local base = 0x30000 + header.tracks_addr -- normally 0x50000
  local addr = base + ti*328 + ri
  return {
    pitch = poke(addr+8,pitch),
    instrument = poke(addr+72,inst),
    volume = poke(addr+136,vol),
    effect = poke(addr+200,eff),
    effect_params = poke(addr+264,effp),
  }
end
function instrument_read(i)
  local base = 0x30000 + sfxheader_read().tracks_addr -- normally 0x40000
  local addr = base + i*0x200
  assert(false,"not implemented")
  -- see https://www.lexaloffle.com/dl/docs/picotron_synth.html#Index
  -- or read /system/apps/sfx.p64/data.lua:clear_instrument() for info
end

-- i: channel index 0..7
function channel_current_track(i)
  return stat(464,0)>>i&1~=0 and stat(400+i,12) or -1
end
-- i: channel index 0..7
function channel_current_row(i)
  return stat(464,0)>>i&1~=0 and stat(400+i,9) or -1
end
-- number of ticks played on current pattern
function channel_ticks_played(i)
  return stat(400+i,11)
end
--currently playing pattern, or -1
function current_pattern(i)
  return stat(466)
end

:: games/collector.lua
--[[pod_format="raw",created="2026-04-15 07:50:25",modified="2026-04-15 08:19:21",revision=8]]
function create_collector_game()
  local game = {
    player_x = 64,
    player_y = 64,
    items = {},
    score = 0,
    timer = 30 * 15,
    finished = false
  }

  local function reset_game(self)
    self.player_x = 64
    self.player_y = 64
    self.items = {}
    self.score = 0
    self.timer = 30 * 15
    self.finished = false

    for i = 1, 12 do
      add(self.items, {
        x = 8 + rnd(112),
        y = 20 + rnd(100),
        taken = false
      })
    end
  end

  local function collide(ax, ay, aw, ah, bx, by, bw, bh)
    return ax < bx + bw and
           bx < ax + aw and
           ay < by + bh and
           by < ay + ah
  end

  function game:init(app)
    reset_game(self)
  end

  function game:update(app)
    local input = app.input

    if self.finished then
      if input.back or input.action then
        finish_minigame(app, "collector", self.score, self.score)
      end
      return
    end

    if input.left then self.player_x = self.player_x - 2 end
    if input.right then self.player_x = self.player_x + 2 end
    if input.up then self.player_y = self.player_y - 2 end
    if input.down then self.player_y = self.player_y + 2 end

    if self.player_x < 0 then self.player_x = 0 end
    if self.player_x > 120 then self.player_x = 120 end
    if self.player_y < 16 then self.player_y = 16 end
    if self.player_y > 120 then self.player_y = 120 end

    for item in all(self.items) do
      if not item.taken and collide(self.player_x, self.player_y, 8, 8, item.x, item.y, 6, 6) then
        item.taken = true
        self.score = self.score + 1
      end
    end

    self.timer = self.timer - 1
    if self.timer <= 0 then
      self.finished = true
    end

    local all_taken = true
    for item in all(self.items) do
      if not item.taken then
        all_taken = false
        break
      end
    end

    if all_taken then
      self.finished = true
    end

    if input.back then
      app.scene_manager:switch("hub")
    end
  end

  function game:draw(app)
    cls(2)

    print("COLLECTOR", 42, 8, 7)
    print("Score: " .. tostr(self.score), 8, 8, 10)
    print("Time: " .. tostr(flr(self.timer / 30)), 92, 8, 9)

    rectfill(self.player_x, self.player_y, self.player_x + 7, self.player_y + 7, 11)

    for item in all(self.items) do
      if not item.taken then
        circfill(item.x + 3, item.y + 3, 3, 10)
      end
    end

    if self.finished then
      rectfill(16, 48, 112, 84, 1)
      print("ROUND OVER", 34, 56, 7)
      print("Collected: " .. tostr(self.score), 34, 66, 7)
      print("X/O: back to hub", 24, 76, 6)
    else
      print("O: hub", 90, 120, 6)
    end
  end

  function game:leave(app)
  end

  return game
end
:: games/dodger.lua
--[[pod_format="raw",created="2026-04-15 07:50:24",modified="2026-04-18 05:59:33",revision=9]]
function create_dodger_game()
  local game = {
    player_x = 64,
    player_y = 112,
    hazards = {},
    spawn_timer = 0,
    score = 0,
    game_over = false
  }

  local function reset_game(self)
    self.player_x = 64
    self.player_y = 112
    self.hazards = {}
    self.spawn_timer = 0
    self.score = 0
    self.game_over = false
  end

  local function collide(ax, ay, aw, ah, bx, by, bw, bh)
    return ax < bx + bw and
           bx < ax + aw and
           ay < by + bh and
           by < ay + ah
  end

  function game:init(app)
    reset_game(self)
  end

	function game:update(app)
	  local input = app.input
	
	  if self.game_over then
	    if input.back then
	    	finish_minigame(app, "dodger", self.score, self.score)
	    end
	    return
	  end
	
	  if input.left then
	    self.player_x = self.player_x - 2
	  end
	  if input.right then
	    self.player_x = self.player_x + 2
	  end
	
	  if self.player_x < 4 then self.player_x = 4 end
	  if self.player_x > 120 then self.player_x = 120 end
	
	  self.spawn_timer = self.spawn_timer - 1
	  if self.spawn_timer <= 0 then
	    add(self.hazards, {
	      x = rnd(120),
	      y = -8,
	      spd = 1 + rnd(2)
	    })
	    self.spawn_timer = 20
	  end
	
	  for h in all(self.hazards) do
	    h.y = h.y + h.spd
	
	    if collide(self.player_x, self.player_y, 8, 8, h.x, h.y, 6, 6) then
	      self.game_over = true
	    end
	  end
	
	  local remaining = {}
	  for h in all(self.hazards) do
	    if h.y < 140 then
	      add(remaining, h)
	    end
	  end
	  self.hazards = remaining
	
	  self.score = self.score + 1
	
	  if input.back then
	    app.scene_manager:switch("hub")
	  end
	end

  function game:draw(app)
    cls(0)

    print("DODGER", 50, 8, 7)
    print("Score: "..tostr(self.score), 8, 8, 11)
    print("O: hub", 90, 8, 6)

    rectfill(self.player_x, self.player_y, self.player_x + 7, self.player_y + 7, 11)

    for h in all(self.hazards) do
      rectfill(h.x, h.y, h.x + 5, h.y + 5, 8)
    end
	if self.game_over then
	  rectfill(20, 48, 108, 84, 1)
	  print("GAME OVER", 42, 56, 7)
	  print("Final: "..tostr(self.score), 42, 66, 7)
	  print("O: back to hub", 30, 76, 6)
	end
   if self.game_over then
     rectfill(20, 48, 108, 84, 1)
     print("GAME OVER", 42, 56, 7)
     print("Final: "..tostr(self.score), 42, 66, 7)
     print("X: back to hub", 30, 76, 6)
   end
 end

  function game:leave(app)
  end

  return game
end
